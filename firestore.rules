rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // User Profiles: Users can read their own data, but only admins can change roles/balances
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) 
        && request.resource.data.role in ['learner', 'client']
        && (!('balance' in request.resource.data) || request.resource.data.balance == 0);
      allow update: if isOwner(userId) 
        && request.resource.data.role == resource.data.role
        && request.resource.data.balance == resource.data.balance
        || isAdmin();
    }
    
    // Projects: 
    // Learners can read and submit translations.
    // Clients can read their own projects and create them.
    match /projects/{projectId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
      // Refine update rules: users can only update segments/progress, not costs/owners
      allow update: if isSignedIn(); 
      allow delete: if isAdmin() || (isSignedIn() && resource.data.ownerId == request.auth.uid);
    }
    
    // Lessons: All authenticated users can read, only admins can write
    match /lessons/{lessonId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    
    // User Skills: Users can only read/write their own skills
    match /userSkills/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }
    
    // Default: Deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
